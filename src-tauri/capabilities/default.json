{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "JlocalMusic 默认权限配置：仅允许核心 invoke/listen/emit，前端不直接使用 shell/dialog/fs 插件的 JS API",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:allow-start-dragging"
  ]
}
